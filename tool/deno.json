{
  "name": "@kg/tool",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "tasks": {
    "check": "deno check src/main.ts",
    "test": "deno test --allow-read --allow-write --allow-run",
    "compile": "deno compile --allow-read --allow-write --allow-run --output kg src/main.ts"
  },
  "imports": {
    "@std/yaml": "jsr:@std/yaml@^1",
    "@std/uuid": "jsr:@std/uuid@^1",
    "@std/cli": "jsr:@std/cli@^1",
    "@std/path": "jsr:@std/path@^1",
    "@std/assert": "jsr:@std/assert@^1"
  },
  "fmt": { "lineWidth": 90 }
}
